---
import siteConfig from "../../../data/site-config.json";

type Classes = typeof siteConfig.translations.es.classes;

interface Props {
    t: Classes["facts"];
}

const { t } = Astro.props;

const icons: Record<string, string> = {
    calendar:
        '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
    users:
        '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
    pin: '<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
    globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
};
---

<section class="relative z-20 px-6 -mt-14 md:-mt-20">
    <dl
        class="reveal opacity-0 translate-y-6 max-w-6xl mx-auto grid grid-cols-2 lg:grid-cols-4 rounded-card border border-gold/20 bg-obsidian-light/80 backdrop-blur-xl shadow-2xl shadow-black/60 overflow-hidden"
    >
        {
            t.map((fact, index) => (
                <div
                    class={`group flex flex-col items-center text-center gap-3 px-4 py-8 md:py-10 border-gold/10
                        ${index % 2 === 0 ? "border-r" : ""}
                        ${index < 2 ? "border-b lg:border-b-0" : ""}
                        ${index === 1 ? "lg:border-r" : ""}`}
                >
                    <span class="w-11 h-11 rounded-full border border-gold/30 bg-gold/5 flex items-center justify-center transition-colors duration-300 group-hover:bg-gold/15">
                        <svg
                            class="w-5 h-5 text-gold"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                            set:html={icons[fact.icon]}
                        />
                    </span>
                    <dt class="text-ivory-muted font-body uppercase tracking-[0.25em] text-[11px] md:text-xs">
                        {fact.label}
                    </dt>
                    <dd class="text-ivory font-heading font-bold text-xl md:text-3xl leading-tight">
                        {fact.value}
                    </dd>
                </div>
            ))
        }
    </dl>
</section>
