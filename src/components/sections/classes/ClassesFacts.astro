---
import siteConfig from "../../../data/site-config.json";

type Classes = typeof siteConfig.translations.es.classes;

interface Props {
    t: Classes["facts"];
}

const { t } = Astro.props;
---

<section class="bg-wine border-y border-gold/15">
    <dl class="max-w-7xl mx-auto grid grid-cols-2 lg:grid-cols-4">
        {
            t.map((fact, index) => (
                <div
                    class={`reveal opacity-0 translate-y-6 text-center px-4 py-10 md:py-14 border-gold/15
                        ${index % 2 === 0 ? "border-r" : ""}
                        ${index < 2 ? "border-b lg:border-b-0" : ""}
                        ${index === 1 ? "lg:border-r" : ""}`}
                >
                    <dt class="text-ivory-muted font-body uppercase tracking-[0.25em] text-xs md:text-sm mb-3">
                        {fact.label}
                    </dt>
                    <dd class="text-gold-light font-heading font-bold text-2xl md:text-4xl">
                        {fact.value}
                    </dd>
                </div>
            ))
        }
    </dl>
</section>
