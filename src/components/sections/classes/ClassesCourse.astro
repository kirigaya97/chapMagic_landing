---
import siteConfig from "../../../data/site-config.json";
import SectionHeading from "../../ui/SectionHeading.astro";
import Reveal from "../../ui/Reveal.astro";

type Classes = typeof siteConfig.translations.es.classes;

interface Props {
    t: Classes["course"];
}

const { t } = Astro.props;
---

<section id="course" class="py-section-mobile md:py-section bg-obsidian px-6">
    <div
        class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
    >
        <div>
            <Reveal>
                <SectionHeading
                    title={t.title}
                    subtitle={t.eyebrow}
                    align="left"
                />
            </Reveal>
            <div class="space-y-6">
                {
                    t.paragraphs.map((paragraph) => (
                        <Reveal>
                            <p
                                class="text-lg md:text-xl text-ivory-muted font-body leading-relaxed [&_strong]:text-ivory [&_strong]:font-semibold"
                                set:html={paragraph}
                            />
                        </Reveal>
                    ))
                }
            </div>
        </div>

        <Reveal>
            <ul
                class="rounded-card border border-gold/20 bg-obsidian-light p-8 md:p-12 space-y-6 shadow-2xl shadow-gold/5"
            >
                {
                    t.features.map((feature) => (
                        <li class="flex items-start gap-4 text-ivory font-body text-lg">
                            <svg
                                class="w-5 h-5 mt-1 shrink-0 text-gold"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path d="M12 0c.6 6.4 5.6 11.4 12 12-6.4.6-11.4 5.6-12 12-.6-6.4-5.6-11.4-12-12 6.4-.6 11.4-5.6 12-12z" />
                            </svg>
                            {feature}
                        </li>
                    ))
                }
            </ul>
        </Reveal>
    </div>
</section>
