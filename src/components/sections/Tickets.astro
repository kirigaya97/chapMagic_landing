---
import SectionHeading from "../ui/SectionHeading.astro";
import Reveal from "../ui/Reveal.astro";
import ShowCards from "../ticketing/ShowCards.astro";
import Calendar from "../ticketing/Calendar.astro";
import { getCatalog } from "../../lib/ticketing/catalog";
import type { TicketingStrings } from "../../lib/ticketing/i18n";

/**
 * Public shows: one card per show (each links to its landing at
 * /<lang>/shows/<id>) and the full calendar with a buy button per date.
 *
 * Dates come from Dinaticket via scripts/ticketing/scrape.mjs, which the
 * `ticketing` GitHub workflow runs every 3 hours. Buy buttons open
 * <TicketModal />, which the page must include once.
 */
interface Props {
    t: {
        sectionTitle: string;
        subtitle: string;
    };
    lang: "es" | "en";
    ticketing: Partial<TicketingStrings>;
}

const { t, lang, ticketing } = Astro.props;
const { shows, performances } = getCatalog(lang);
---

<section id="tickets" class="py-section-mobile md:py-section bg-obsidian px-6">
    <div class="max-w-6xl mx-auto">
        <SectionHeading title={t.sectionTitle} subtitle={t.subtitle} />

        <Reveal>
            <ShowCards
                lang={lang}
                shows={shows}
                performances={performances}
                strings={ticketing}
                heading={false}
                id="tickets-shows"
            />
        </Reveal>

        <div
            class="mt-section-mobile md:mt-24 rounded-card border border-gold/20 bg-obsidian-light/60 p-6 md:p-12"
        >
            <Calendar
                lang={lang}
                shows={shows}
                performances={performances}
                strings={ticketing}
                emptyHref={`/${lang}/#contact`}
                id="tickets-calendar"
            />
        </div>
    </div>
</section>
