---
import SectionHeading from "../ui/SectionHeading.astro";
import Reveal from "../ui/Reveal.astro";
import ShowCards from "../ticketing/ShowCards.astro";
import Button from "../ui/Button.astro";
import { getCatalog } from "../../lib/ticketing/catalog";
import type { TicketingStrings } from "../../lib/ticketing/i18n";

/**
 * Home teaser for public shows: one card per show (each links to its landing
 * at /<lang>/shows/<id>) and a button to the full calendar at /<lang>/entradas.
 *
 * Dates come from Dinaticket via scripts/ticketing/scrape.mjs, which the
 * `ticketing` GitHub workflow runs every 3 hours.
 */
interface Props {
    t: {
        sectionTitle: string;
        subtitle: string;
    };
    lang: "es" | "en";
    ticketing: Partial<TicketingStrings> & { page: { homeCta: string } };
}

const { t, lang, ticketing } = Astro.props;
const { shows, performances } = getCatalog(lang);
---

<section id="tickets" class="py-section-mobile md:py-section bg-obsidian px-6">
    <div class="max-w-6xl mx-auto">
        <SectionHeading title={t.sectionTitle} subtitle={t.subtitle} />

        <Reveal>
            <ShowCards
                lang={lang}
                shows={shows}
                performances={performances}
                strings={ticketing}
                heading={false}
                id="tickets-shows"
            />
        </Reveal>

        <Reveal class="mt-12 text-center">
            <Button variant="gold" href={`/${lang}/entradas`} class="text-lg">
                {ticketing.page.homeCta}
            </Button>
        </Reveal>
    </div>
</section>
