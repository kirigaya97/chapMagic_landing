---
import GoldenBorder from "./GoldenBorder.astro";

interface Props {
    name: string;
    price: string;
    unit: string;
    highlight: string;
    features: string[];
    recommended?: boolean;
    recommendedLabel: string;
}

const {
    name,
    price,
    unit,
    highlight,
    features,
    recommended = false,
    recommendedLabel,
} = Astro.props;
---

<div
    class={`price-card relative h-full rounded-card p-8 md:p-12 border transition-colors duration-500 ${
        recommended
            ? "border-gold/70 bg-gradient-to-b from-gold/[0.07] to-obsidian-light shadow-2xl shadow-gold/10"
            : "border-gold/20 bg-obsidian-light"
    }`}
>
    <GoldenBorder selector=".price-card" borderRadius={12} />

    {
        recommended && (
            <span class="absolute -top-4 right-6 md:right-10 bg-gold text-obsidian text-xs font-body font-bold uppercase tracking-[0.2em] px-5 py-2 rounded-full">
                {recommendedLabel}
            </span>
        )
    }

    <h3
        class="text-ivory-muted font-body font-semibold uppercase tracking-[0.2em] text-sm md:text-base mb-8"
    >
        {name}
    </h3>

    <p class="flex items-baseline flex-wrap gap-x-3 mb-3">
        <span
            class="text-6xl md:text-7xl font-heading font-bold text-ivory leading-none"
            >{price}</span
        >
        <span class="text-xl md:text-2xl font-body text-ivory-muted">{unit}</span>
    </p>
    <p class="text-gold font-body font-semibold mb-8">{highlight}</p>

    <ul class="space-y-3">
        {
            features.map((feature) => (
                <li class="flex gap-4 text-ivory-muted font-body leading-relaxed">
                    <span class="text-gold shrink-0" aria-hidden="true">
                        —
                    </span>
                    {feature}
                </li>
            ))
        }
    </ul>
</div>
